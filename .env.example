# Copy this file to .env and fill in your own values.
# Only PORTAL_SECRET_KEY really matters for a real deployment - everything
# else has a sane default.

# A long random string - without this, every restart logs you out of /admin.
PORTAL_SECRET_KEY=change-this-to-a-long-random-string

# Port exposed on your host machine (docker compose only - the app always
# listens on 5000 inside the container).
HOST_PORT=5000

# Backend health-check frequency, in seconds.
PORTAL_CHECK_INTERVAL_SECONDS=120

# Public page auto-refresh frequency, in seconds.
PORTAL_PUBLIC_REFRESH_SECONDS=60

# How often the resources page (admin, and public if enabled in Settings) auto-refreshes.
PORTAL_RESOURCE_REFRESH_SECONDS=10

# Set to true only if a reverse proxy (nginx, Caddy, Cloudflare Tunnel...) sits in
# front of this app. Enables trusting its X-Forwarded-* headers. Leave false if the
# app's port is reachable directly (e.g. bare Tailscale, LAN).
PORTAL_BEHIND_PROXY=false

# Set to true once this is served over HTTPS (directly, or via a TLS-terminating
# reverse proxy) - marks the session cookie Secure. Leave false for plain-HTTP setups.
PORTAL_FORCE_HTTPS_COOKIES=false

# Optional: get pinged on incident open/resolve/update and maintenance start/end,
# instead of only finding out by looking at the page. Leave blank to disable either.
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL.
PORTAL_DISCORD_WEBHOOK_URL=
# ntfy: the full topic URL, e.g. https://ntfy.sh/your-secret-topic-name (or your own
# self-hosted ntfy server). Treat the topic name as a secret - anyone who knows it can
# read your notifications on a public ntfy.sh server.
PORTAL_NTFY_URL=

# Optional: a real Discord bot (separate feature from the webhook above) that can
# update its own presence/status and/or respond to a slash command in a channel with a
# self-editing status message. Requires `pip install discord.py` (not in
# requirements.txt - optional heavy dependency, same idea as nvidia-ml-py for GPU
# monitoring). Leave blank to disable entirely. See /admin/discord-bot once set.
PORTAL_DISCORD_BOT_TOKEN=
# How often the bot refreshes its presence/edits its tracked status messages, in seconds.
PORTAL_DISCORD_BOT_REFRESH_SECONDS=300
# Optional - if this bot only lives in one server, set its ID here for instant slash-
# command registration (enable Developer Mode in Discord, then right-click your
# server icon -> Copy Server ID). Left blank, the command syncs globally instead,
# which works everywhere but can take up to an hour to first appear.
PORTAL_DISCORD_BOT_GUILD_ID=

# HTTP timeout (seconds) for the Byparr integration's /health check specifically.
# Byparr's /health makes it actually solve a live Cloudflare challenge before
# responding, which routinely takes much longer than a normal REST call - raise
# this if you still see "Read timed out" for a Byparr integration.
PORTAL_BYPARR_TIMEOUT_SECONDS=30

# How often the portal asks GitHub whether a newer release exists, in seconds
# (6h by default). The result is cached and shown on /admin/about; the check itself
# can also be turned off entirely from that page.
PORTAL_UPDATE_CHECK_INTERVAL_SECONDS=21600

# Set to false to remove the admin panel's "Update now" button entirely. The
# standalone `python update.py apply` script still works over SSH. This is an env
# var rather than a setting in the admin UI on purpose: the risk it addresses is
# "someone got into the admin panel", and a toggle that same person could flip from
# that same panel would address nothing. Changing it needs host filesystem access
# plus a restart.
PORTAL_ENABLE_INAPP_UPDATE=true
