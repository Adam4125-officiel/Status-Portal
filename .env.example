# Copy this file to .env and fill in your own values.
# Only PORTAL_SECRET_KEY really matters for a real deployment - everything
# else has a sane default.

# A long random string - without this, every restart logs you out of /admin.
PORTAL_SECRET_KEY=change-this-to-a-long-random-string

# Port exposed on your host machine (docker compose only - the app always
# listens on 5000 inside the container).
HOST_PORT=5000

# Backend health-check frequency, in seconds.
PORTAL_CHECK_INTERVAL_SECONDS=120

# Public page auto-refresh frequency, in seconds.
PORTAL_PUBLIC_REFRESH_SECONDS=60

# Disk path the admin resource monitor reports free/used space for.
PORTAL_MONITOR_DISK_PATH=/
